# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-5 (falls back to claude-sonnet-4-5 if unavailable).
# Used for extraction and the analyst.
ANTHROPIC_MODEL=claude-sonnet-5
# Optional. Fast model for RFx drafting only. Defaults to claude-haiku-4-5
# (falls back to claude-haiku-4-5-20251001, then sonnet). The seeded Chakan
# example brief skips the LLM entirely (cached fixture).
ANTHROPIC_DRAFT_MODEL=claude-haiku-4-5
# Optional. Fast model for vendor extract + image transcription (live API). Defaults to claude-haiku-4-5.
# Analyst / Ask still use ANTHROPIC_MODEL (Sonnet).
ANTHROPIC_EXTRACT_MODEL=claude-haiku-4-5
# Optional. Set automatically on Vercel when a Blob store is connected. Leave empty locally to use data/store/.
BLOB_READ_WRITE_TOKEN=
